        { "key": "HKCU\\Control Panel\\Accessibility\\StickyKeys", "name": "Flags", "type": "string", "value": "506", "off": "510" },
        { "key": "HKCU\\Control Panel\\Accessibility\\ToggleKeys", "name": "Flags", "type": "string", "value": "58", "off": "62" },
        { "key": "HKCU\\Control Panel\\Accessibility\\Keyboard Response", "name": "Flags", "type": "string", "value": "122", "off": "126" }
      ]
    },
    {
      "id": "system.restartNotice",
      "category": "system",
      "name": "Попереджати про перезавантаження",
      "description": "Windows заздалегідь повідомить, що для оновлення потрібне перезавантаження, а не перезапуститься несподівано.",
      "default": true,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SOFTWARE\\Microsoft\\WindowsUpdate\\UX\\Settings", "name": "RestartNotificationsAllowed2", "type": "dword", "value": 1 }
      ]
    },
    {
      "id": "system.noStartupDelay",
      "category": "system",
      "name": "Автозапуск без затримки",
      "description": "Програми з автозапуску стартують одразу після входу, а не через кілька секунд.",
      "default": true,
      "effect": "signin",
      "set": [
        { "key": "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Serialize", "name": "StartupDelayInMSec", "type": "dword", "value": 0 }
      ]
    },
    {
      "id": "system.noAutoEncryption",
      "category": "system",
      "name": "Без самовільного шифрування диска",
      "description": "Windows не вмикає BitLocker сама. З локальним акаунтом ключ відновлення легко втратити разом з усіма даними. Увімкнути шифрування можна будь-коли вручну.",
      "default": true,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\BitLocker", "name": "PreventDeviceEncryption", "type": "dword", "value": 1 }
      ]
    },
    {
      "id": "system.memoryIntegrity",
      "category": "system",
      "name": "Ізоляція ядра",
      "description": "Захищає ядро від шкідливих і вразливих драйверів. Vanguard і сучасні ігри з нею працюють. Якщо драйвер несумісний, Windows покаже його в «Безпеці Windows».",
      "default": false,
      "effect": "restart",
      "set": [
        { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity", "name": "Enabled", "type": "dword", "value": 1, "off": 0 }
      ]
    },
    {
      "id": "system.noFastStartup",
      "category": "system",
      "name": "Без швидкого запуску",
      "description": "«Завершення роботи» справді вимикає ПК: драйвери й оновлення застосовуються начисто.",
      "default": false,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power", "name": "HiberbootEnabled", "type": "dword", "value": 0, "off": 1 }
      ]
    },
    {
      "id": "system.noHibernation",
      "category": "system",
      "name": "Без гібернації",
      "description": "Звільняє на диску гігабайти під hiberfil.sys. Для ноутбуків краще лишити гібернацію.",
      "default": false,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power", "name": "HibernateEnabled", "type": "dword", "value": 0, "off": 1 }
      ],
      "run": { "on": "powercfg.exe /hibernate off", "off": "powercfg.exe /hibernate on" }
    },
    {
      "id": "system.noDriverUpdates",
      "category": "system",
      "name": "Драйвери не з Windows Update",
      "description": "Windows не підмінює драйвери відеокарти й іншого заліза своїми. Ставте драйвери з сайту виробника.",
      "default": false,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsUpdate", "name": "ExcludeWUDriversInQualityUpdate", "type": "dword", "value": 1 },
        { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\DriverSearching", "name": "SearchOrderConfig", "type": "dword", "value": 0 }
      ]
    },
    {
      "id": "system.noRestorePoints",
      "category": "system",
      "name": "Без точок відновлення",
      "description": "Windows не робить точок відновлення й не займає під них диск. Повернутися до попереднього стану ними вже не вийде.",
      "default": false,
      "effect": "now",
      "set": [
        { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\SystemRestore", "name": "DisableSR", "type": "dword", "value": 1 },
        { "key": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\SystemRestore", "name": "DisableConfig", "type": "dword", "value": 1 }
      ]
    }
  ],
